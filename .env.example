# Copy to .env.local and fill in. Never commit real values.

# Optional, server-only Sanity token (read-only "Viewer" role). Only needed if the
# dataset is private; leave empty for a public dataset.
SANITY_READ_TOKEN=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only; used by pages/api/stripe.js.
STRIPE_SECRET_KEY=
