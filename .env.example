# Copy to .env.local and fill in values from your own accounts. Never commit real keys.

# Browser-safe (inlined into the client bundle by Next.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only secrets (no NEXT_PUBLIC_ prefix; load from the deployment's secret store)
STRIPE_SECRET_KEY=sk_test_replace_me
SANITY_TOKEN=replace_me
